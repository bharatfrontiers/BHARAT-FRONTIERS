{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "bharat-frontiers",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-09-20",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bharat-frontiers-db",
      "database_id": "c161da05-6866-4c0a-91e4-39b4885c3a0b"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "PUBLICATION_RULE": "NO_VERIFIED_SOURCE_NO_PUBLICATION"
  }
}
